+// then be a plausible reason the timing changed.
+// How many nodes between encode lines. 64 keeps a 1591-node graph to ~25 lines, which
+// is enough to say which phase a stall is in. Narrowing a stall to one node needs
+// GGML_WEBGPU_TRACE_STRIDE=1, which is far too noisy to be the default but is the whole
+// point once a graph is known to stop somewhere in a 64-node window.
+static int ggml_webgpu_trace_stride() {
+    static const int stride = [] {
+        const char * env = getenv("GGML_WEBGPU_TRACE_STRIDE");
+        const int    n   = env ? atoi(env) : 0;
+        return n > 0 ? n : 64;
+    }();
+    return stride;
