 // Wait for the queue to finish processing all submitted work
+// Progress trace for graph_compute. Off unless GGML_WEBGPU_TRACE is set in the
+// environment, so one build can be carried to a machine where a stall reproduces and
+// switched on there rather than rebuilt there.
+//
+// This exists because a stalled graph_compute is completely silent. The WaitAny loop
+// below retries on TimedOut *and* on Error without erasing the submission, so a
+// submission that never completes spins forever with no output at all. Whether we are
+// still encoding, waiting on an intermediate submit, or spinning in the final wait are
+// three different bugs, and nothing in the current output distinguishes them.
+static bool ggml_webgpu_trace_enabled() {
+    static const bool enabled = getenv("GGML_WEBGPU_TRACE") != nullptr;
+    return enabled;
+}
+
+#define WEBGPU_TRACE(...)                                    \
+    do {                                                     \
+        if (ggml_webgpu_trace_enabled()) {                   \
+            GGML_LOG_INFO("webgpu-trace: " __VA_ARGS__);      \
+        }                                                    \
+    } while (0)
+
+// One line per node would be thousands of lines per graph, and the logging itself would
+// then be a plausible reason the timing changed.
+#define WEBGPU_TRACE_NODE_STRIDE 64
+
+static const char * ggml_webgpu_wait_status_name(wgpu::WaitStatus status) {
+    switch (status) {
+        case wgpu::WaitStatus::Success:
+            return "Success";
+        case wgpu::WaitStatus::TimedOut:
+            return "TimedOut";
+        case wgpu::WaitStatus::Error:
+            return "Error";
+        default:
+            return "Unknown";
+    }
+}
+
+// 1, 10, 50, then every 100 up to 1000, then every 1000. At a 100 ms timeout that is
+// roughly: immediately, 1 s, 5 s, every 10 s, then every 100 s.
+static bool ggml_webgpu_trace_retry(uint64_t n) {
+    if (n <= 1 || n == 10 || n == 50) {
+        return true;
+    }
+    if (n < 100) {
+        return false;
+    }
+    if (n <= 1000) {
+        return n % 100 == 0;
+    }
+    return n % 1000 == 0;
+}
+
