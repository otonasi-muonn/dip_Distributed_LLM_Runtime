+// Progress trace for graph_compute. Off unless GGML_WEBGPU_TRACE is set in the
+// environment, so one build can be carried to a machine where a stall reproduces and
+// switched on there rather than rebuilt there.
+//
+// This exists because a stalled graph_compute is completely silent. The WaitAny loop
+// below retries on TimedOut *and* on Error without erasing the submission, so a
+// submission that never completes spins forever with no output at all. Whether we are
+// still encoding, waiting on an intermediate submit, or spinning in the final wait are
+// three different bugs, and nothing in the current output distinguishes them.
+static bool ggml_webgpu_trace_enabled() {
+    static const bool enabled = getenv("GGML_WEBGPU_TRACE") != nullptr;
+    return enabled;
+}
+#define WEBGPU_TRACE(...)                                    \
+    do {                                                     \
+        if (ggml_webgpu_trace_enabled()) {                   \
+            GGML_LOG_INFO("webgpu-trace: " __VA_ARGS__);      \
+        }                                                    \
+    } while (0)
